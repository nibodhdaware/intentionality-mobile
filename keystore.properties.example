# Copy this file to keystore.properties (git-ignored) and fill in the values,
# or set the equivalent RELEASE_STORE_* environment variables.
#
# The keystore file itself must never be committed.
#
# IMPORTANT: do not reuse the previously committed key_store.jks. It is
# exposed in this repository's public git history, so treat it as compromised.
# Generate a new upload keystore and register/reset it in Play Console
# (Play App Signing), then point storeFile at the new file.
#
# storeFile may be absolute or relative to the repository root.
storeFile=/absolute/path/to/new-upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
